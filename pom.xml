<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <url>http://maven.apache.org</url>

  <!-- package -->
  <groupId>tool</groupId>

  <!-- アプリ名 -->
  <artifactId>ChkDbConn</artifactId>
  <name>ChkDbConn</name>

  <!-- バージョン -->
  <version>1.0</version>

  <!-- パッケージファイル形式 -->
  <packaging>jar</packaging>

  <properties>
    <!-- ソールファイルの文字コード -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- カスタム変数 -->
    <jvmver>1.8</jvmver>
    <jrever>jre8</jrever>
    <!-- JAVAバージョン -->
    <java.version>${jvmver}</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
  </properties>

  <!-- パッケージ化の設定 -->
  <build>
    <finalName>${project.artifactId}-${project.version}-${jrever}</finalName>
    <plugins>
      <!-- マニフェスト設定 -->
      <!-- 不要：maven-shade-plugin側で設定
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>tool.${project.artifactId}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      -->
      <!-- 依存ライブラリ同梱化 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${project.groupId}.${project.artifactId}</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- 依存ライブラリ -->
  <dependencies>

    <!-- 単体テスト -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.2.224</version>
      <scope>test</scope>
    </dependency>

    <!-- JDBCドライバー：MySQL：https://mvnrepository.com/artifact/com.mysql/mysql-connector-j/ -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>9.7.0</version>
      <scope>compile</scope>
    </dependency>

    <!-- JDBCドライバー：MySQL：https://repo.maven.apache.org/maven2/com/microsoft/sqlserver/mssql-jdbc/ -->
    <!--
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <version>3.5.10</version>
    </dependency>
    -->

    <!-- JDBCドライバー：PostgreSQL：https://repo.maven.apache.org/maven2/org/postgresql/postgresql/ -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.13</version>
    </dependency>

    <!-- JDBCドライバー：SQL SERVER：https://repo.maven.apache.org/maven2/com/microsoft/sqlserver/mssql-jdbc/ -->
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <version>13.4.0.jre8</version>
    </dependency>

    <!-- JDBCドライバー：Oracle：JDK 8、JDK 11：https://repo.maven.apache.org/maven2/com/oracle/database/jdbc/ojdbc8/ -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc8</artifactId>
      <version>23.26.3.0.0</version>
    </dependency>

    <!-- JDBCドライバー：Oracle：JDK 11、JDK 17：https://repo.maven.apache.org/maven2/com/oracle/database/jdbc/ojdbc10/ -->
    <!--
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc10</artifactId>
      <version>19.32.0.0</version>
    </dependency>
    -->
    <!-- JDBCドライバー：Oracle：JDK 11、JDK 17、JDK 19、JDK 21：https://repo.maven.apache.org/maven2/com/oracle/database/jdbc/ojdbc11/ -->
    <!--
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>23.26.3.0.0</version>
    </dependency>
    -->

    <!-- 関連ライブラリ：Oracle：国際化 https://repo.maven.apache.org/maven2/com/oracle/database/nls/orai18n/ -->
    <!--
    <dependency>
      <groupId>com.oracle.database.nls</groupId>
      <artifactId>orai18n</artifactId>
      <version>21.22.0.0</version>
    </dependency>
    -->

  </dependencies>
</project>


